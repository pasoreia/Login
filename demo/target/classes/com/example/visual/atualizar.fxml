<?xml version="1.0" encoding="UFT-8"?>


<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>

<GridPane  xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.visual.TerceiroController"
vgap ="10" hgap="10" alignment="TOP_LEFT">
    <children>
        <HBox spacing="10" GridPane.rowIndex="0" GridPane.columnIndex="0">
            <children>
                <Label text="Atualizar nome:" />
                <TextField fx:id="id" promptText="Id" prefWidth="30"/>
                <TextField fx:id="atualizarNome" promptText="Atualize o nome"/>
                <Button fx:id="nomeAtualizado" text="Atualizar Nome" onAction="#nomeAtualizado"/>
            </children>
        </HBox>
        <HBox spacing="10" GridPane.rowIndex="5" GridPane.columnIndex="0">
            <children>
               
                <Button fx:id="login" text="Voltar para o Login" onAction="#switchToPrimary"/>
                <Button fx:id="cadastr" text="Cadastro" onAction="#cadastro"/>
                
            </children>
        </HBox>
        <HBox spacing="10" GridPane.rowIndex="1" GridPane.columnIndex="0">
            <children>
                <Label text="Atualizar E-mail:"/>
                <TextField fx:id="id_1" promptText="Id" prefWidth="30"/>
                <TextField fx:id="atualizarEmail" promptText="Atualizar E-mail"/>
                <Button fx:id="emailAtualizado" text="Atualizar E-mail" onAction="#emailAtualizado" />
            </children>
        </HBox>
         <HBox spacing="10" GridPane.rowIndex="2" GridPane.columnIndex="0">
            <children>
                <Label text="Atualizar telefone"/>
                <TextField fx:id="id_2" promptText="Id" prefWidth="30"/>
                <TextField fx:id="atualizarTelefone" promptText="Atualizar telefone"/>
                <Button fx:id="telefoneAtualizado" text="Atualizar telefone" onAction="#telefoneAtualizado" />
            </children>
        </HBox>
        <HBox spacing="10" GridPane.rowIndex="3" GridPane.columnIndex="0">
            <children>
                <Label text="Atualizar endereço:"/>
                <TextField fx:id="id_3" promptText="Id" prefWidth="30"/>
                <TextField fx:id="atualizarEndereco" promptText="Atualizar Endereço"/>
                <Button fx:id="enderecoAtualizado" text="Atualizar Endereço" onAction="#enderecoAtualizado" />
            </children>
        </HBox>
        <HBox spacing="10" GridPane.rowIndex="4" GridPane.columnIndex="0">
            <children>
                <Label text="Atualizar Senha:"/>
                <TextField fx:id="id_4" promptText="Id" prefWidth="30"/>
                <TextField fx:id="atualizarSenha" promptText="Escolha a novo senha"/>
                <Button fx:id="senhaAtualizado" text="Atualizar senha" onAction="#senhaAtualizado" />
            </children>
        </HBox>
    </children>
  <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
</GridPane>